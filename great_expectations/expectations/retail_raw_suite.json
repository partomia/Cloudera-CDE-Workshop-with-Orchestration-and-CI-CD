{
  "expectation_suite_name": "retail_raw_suite",
  "expectations": [
    {
      "expectation_type": "expect_table_row_count_to_be_between",
      "kwargs": { "min_value": 1, "max_value": null },
      "meta": { "notes": "Table must not be empty" }
    },
    {
      "expectation_type": "expect_column_to_exist",
      "kwargs": { "column": "order_id" }
    },
    {
      "expectation_type": "expect_column_to_exist",
      "kwargs": { "column": "customer_id" }
    },
    {
      "expectation_type": "expect_column_to_exist",
      "kwargs": { "column": "product_id" }
    },
    {
      "expectation_type": "expect_column_to_exist",
      "kwargs": { "column": "order_date" }
    },
    {
      "expectation_type": "expect_column_to_exist",
      "kwargs": { "column": "quantity" }
    },
    {
      "expectation_type": "expect_column_to_exist",
      "kwargs": { "column": "unit_price" }
    },
    {
      "expectation_type": "expect_column_to_exist",
      "kwargs": { "column": "category" }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": { "column": "order_id" },
      "meta": { "notes": "Every row must have an order_id" }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": { "column": "customer_id" }
    },
    {
      "expectation_type": "expect_column_values_to_be_unique",
      "kwargs": { "column": "order_id" },
      "meta": { "notes": "order_id must be a primary key" }
    },
    {
      "expectation_type": "expect_column_values_to_be_between",
      "kwargs": { "column": "quantity", "min_value": 1, "max_value": 10000 }
    },
    {
      "expectation_type": "expect_column_values_to_be_between",
      "kwargs": { "column": "unit_price", "min_value": 0.01, "max_value": 100000 }
    },
    {
      "expectation_type": "expect_column_values_to_match_regex",
      "kwargs": {
        "column": "order_date",
        "regex": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "meta": { "notes": "Date must be YYYY-MM-DD format" }
    },
    {
      "expectation_type": "expect_column_values_to_be_in_set",
      "kwargs": {
        "column": "category",
        "value_set": ["ELECTRONICS", "CLOTHING", "FOOD", "FURNITURE", "SPORTS", "BOOKS", "TOYS"]
      },
      "meta": { "notes": "Category must be a known value" }
    }
  ],
  "meta": {
    "great_expectations_version": "0.18.9"
  }
}
